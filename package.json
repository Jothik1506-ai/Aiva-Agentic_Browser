{
  "name": "aiva-agentic-browser",
  "version": "0.1.0-beta.1",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.aivafreelancia.agenticbrowser",
    "productName": "AIVA Agentic Browser",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "breathing.html",
      "breathing.js",
      "breathing.css",
      "neck.html",
      "neck.js",
      "neck.css",
      "meditation.html",
      "meditation.js",
      "meditation.css",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*", "!__pycache__/**"]
      }
    ],
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico"
    }
  }
}
